# Copy to `env` (which is git-ignored) and edit. Sourced by every script here.

# Where remote hosts dial the lighthouse — your public IP or dynamic-DNS name,
# plus the Nebula UDP port. This is the ONLY thing you forward on the router.
PUBLIC_ENDPOINT=vault.duckdns.org:4242

# The private overlay. The lighthouse (this machine) takes .1; the coordinator
# and anchor bind that address, so they are unreachable from the public internet.
OVERLAY_CIDR=192.168.100.0/24
LIGHTHOUSE_OVERLAY_IP=192.168.100.1
NEBULA_PORT=4242
CA_NAME=VaultMesh Overlay CA

# Object store (anchor) credentials — the coordinator holds these and mints
# presigned URLs; node-agents never see them. MINIO_ROOT_PASSWORD must be >= 8.
VAULT_S3_ACCESS_KEY=change-me
VAULT_S3_SECRET_KEY=change-me-too
VAULT_S3_BUCKET=vaultmesh
# VAULT_S3_ENDPOINT defaults to http://<LIGHTHOUSE_OVERLAY_IP>:9000
